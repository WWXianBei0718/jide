# Supabase Configuration
# URL and Publishable Key can be found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Server-side only)
# Found in Supabase Project Settings -> API -> Service Role
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API Key
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs API Key (Secret Key for full functionality)
# Create one at https://elevenlabs.io/docs/api-reference/authentication
# Note: Use Secret Key (sk_xxx), not Publishable Key
ELEVENLABS_API_KEY=

# File uploads are enabled by default in development and require an explicit
# production flag. Keep unscanned publishing disabled until a malware scanner
# is connected to the quarantine workflow.
ENABLE_FILE_UPLOADS=false
ENABLE_UNSCANNED_UPLOADS=false

# Private ClamAV daemon used by the asynchronous quarantine scanner.
# Keep uploads quarantined when these are not configured.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_SCANNER_VERSION=
MALWARE_SCAN_WORKER_ID=clamav-worker:production

# Private/local OCR adapter. The endpoint accepts raw JPEG/PNG/WebP bytes and
# returns JSON shaped as {"text":"..."}. Public internet hosts are rejected.
LOCAL_OCR_ENDPOINT=http://paddleocr:8868/ocr
LOCAL_OCR_PROCESSOR_VERSION=paddleocr-3.7-ppocrv6-v1

# Private/local speech-to-text adapter. The endpoint accepts raw supported
# audio/video bytes and returns JSON shaped as {"text":"..."}. Public hosts
# and embedded endpoint credentials are rejected.
LOCAL_TRANSCRIPTION_ENDPOINT=http://whisper:9000/transcribe
LOCAL_TRANSCRIPTION_PROCESSOR_VERSION=faster-whisper-large-v3-v1
MATERIAL_PROCESSING_WORKER_ID=material-worker:production

# Voice cloning has a separate production release gate because it transfers
# biometric voice samples to a third-party processor.
ENABLE_VOICE_CLONING=false
