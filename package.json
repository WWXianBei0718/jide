{
  "name": "remember",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/*.test.ts",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "check": "npm test && npm run build",
    "eval:persona:dry": "tsx scripts/run-persona-eval.ts --dry-run",
    "eval:persona:dry:smoke": "tsx scripts/run-persona-eval.ts --dry-run --smoke",
    "eval:persona": "tsx scripts/run-persona-eval.ts",
    "eval:persona:smoke": "tsx scripts/run-persona-eval.ts --smoke",
    "eval:persona:resume": "tsx scripts/run-persona-eval.ts --resume",
    "eval:persona:resume:smoke": "tsx scripts/run-persona-eval.ts --resume --smoke",
    "eval:persona:rescore": "tsx scripts/run-persona-eval.ts --rescore-only",
    "eval:retrieval": "tsx scripts/run-retrieval-eval.ts",
    "memory:backfill:dry": "tsx scripts/run-memory-backfill.ts",
    "memory:backfill": "tsx scripts/run-memory-backfill.ts --execute"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "archiver": "^8.0.0",
    "next": "^15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.6.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.16"
    }
  }
}
